{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "node",
    "outDir": "public/js",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/client/**/*.ts", "src/game/types.ts", "src/game/scoring.ts"],
  "exclude": ["src/**/*.test.ts", "src/server/**"]
}
