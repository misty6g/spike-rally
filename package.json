{
  "name": "spike-rally",
  "version": "1.0.0",
  "description": "Real-time 2D volleyball mini-game with local and room-code multiplayer",
  "author": "Gyan Mistry",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/misty6g/spike-rally.git"
  },
  "keywords": ["volleyball", "typescript", "canvas", "websocket", "multiplayer"],
  "main": "dist/server/index.js",
  "scripts": {
    "build": "tsc && tsc -p tsconfig.client.json",
    "build:server": "tsc",
    "build:client": "tsc -p tsconfig.client.json",
    "start": "node dist/server/index.js",
    "dev": "npm run build:client && tsx watch src/server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.21.2",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/ws": "^8.18.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
